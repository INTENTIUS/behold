#!/usr/bin/env node
// behold#999's e2e stand-in for choudoufu: no cloud, no provider, no state
// read. It logs every invocation to $ADOPT_STUB_LOG (one JSON argv per line),
// answers init (chant#4461), passes live-check, and for live-import without -approve prints the
// ratification report in the text choudoufu's human view prints
// (internal/command/views/live_import.go), rendered from the recorded report
// in $ADOPT_STUB_REPORT (example-terraform-estate/recorded/adoption/<root>.json).
// With -approve it prints one line and writes nothing either: the e2e reads
// the log to see whether -approve was ever asked for.
// behold is "type": "module", so node loads this extensionless file as ESM.
import { appendFileSync, readFileSync } from "node:fs";
const argv = process.argv.slice(2);
if (process.env.ADOPT_STUB_LOG) appendFileSync(process.env.ADOPT_STUB_LOG, JSON.stringify({ argv, cwd: process.cwd() }) + "\n");
const flag = (name) => (argv.find((a) => a.startsWith(`-${name}=`)) || "").slice(name.length + 2);
// chant#4461: promote stages each root in a fresh git worktree and runs
// `choudoufu init -input=false -backend=false -no-color` there before
// live-check, so the report's provider reads have plugins. The stand-in reads
// no provider, so it installs nothing and answers as init does on success.
if (argv[0] === "init") {
  console.log("\nOpenTofu has been successfully initialized!");
  process.exit(0);
}
if (argv[0] === "live-check") {
  console.log("live-check: ok");
  process.exit(0);
}
if (argv[0] !== "live-import") {
  console.error(`stub choudoufu: ${argv[0]} is not stubbed`);
  process.exit(2);
}
if (argv.includes("-approve")) {
  console.log(`stub choudoufu: -approve for estate ${flag("estate")} (nothing stamped: this is the e2e stand-in)`);
  process.exit(0);
}
const doc = JSON.parse(readFileSync(process.env.ADOPT_STUB_REPORT, "utf8"));
const entries = doc.adoption.entries;
const order = ["VERIFIED", "DRIFTED", "MISSING", "UNTAGGABLE", "UNADMITTED_TYPE"];
const head = {
  VERIFIED: "verified against the live system",
  DRIFTED: "verified, but drifted from the live system",
  MISSING: "could not be verified",
  UNTAGGABLE: "outside the taggable subset",
  UNADMITTED_TYPE: "outside the admitted type set",
};
let out = `\nRatifying ${flag("state")} for estate "${flag("estate")}" against the live system. This was read-only: nothing was written.\n\n`;
for (const st of order) {
  const rows = entries.filter((e) => e.status === st).sort((a, b) => (a.address < b.address ? -1 : 1));
  if (!rows.length) continue;
  out += `${st} (${rows.length}) - ${head[st]}:\n`;
  for (const e of rows) out += `  ${e.address.padEnd(42)} ${e.type.padEnd(24)} live id: ${e.liveId || "-"}\n    ${e.detail}\n`;
  out += "\n";
}
const eligible = entries.filter((e) => e.status === "VERIFIED" || e.status === "DRIFTED").length;
out += `${eligible} of ${entries.length} resource instance(s) are eligible for stamping (VERIFIED or DRIFTED).\n`;
process.stdout.write(out);
