# The demo host's only public listener (#570). Caddy gets and renews the
# Let's Encrypt certificate for the name itself (HTTP-01 on port 80, which is
# why 80 is open), redirects http to https, and proxies to behold on the
# compose network. behold is --public: GET, HEAD and OPTIONS only.
#
# Until the morning of 2026-11-04 the site asks for a password. The
# basic_auth block is not in this file: demo-host.sh bootstrap writes it to
# /etc/demo-host/caddy/password.caddy on the host (mounted here as
# /etc/caddy/auth), with a bcrypt hash of the password it was given. The
# import below is a glob, so when no file matches it imports nothing and
# Caddy only logs a warning.
#
# Launch morning, one line on the host (README.md, "Launch morning"):
#
#   sudo /opt/demo/behold/deploy/demo-host/demo-host.sh open
#
# which renames password.caddy to password.caddy.off and reloads Caddy.

{$DEMO_HOSTNAME:demo.intentius.io} {
	import /etc/caddy/auth/*.caddy

	# behold#978: browser security headers on every answer. The kiosk frames
	# behold's own view (/?embed=1&...), same origin, so framing is limited to
	# this origin rather than refused outright: X-Frame-Options DENY would
	# blank the kiosk in any browser that reads it over frame-ancestors.
	# The CSP is added (+), never set: behold serves a report page with its
	# own `sandbox` policy (src/terragucci-view.ts), and a browser enforces
	# both. `defer` applies these after behold's answer is written, so the
	# add lands next to behold's header rather than before it.
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options SAMEORIGIN
		+Content-Security-Policy "frame-ancestors 'self'"
	}

	# The demo is served at the root by behold itself (/choudoufu-compose and its
	# siblings are its own routes, /kiosk redirects to /), so nothing redirects here.

	# The view's live updates are server-sent events; send each one on as
	# it comes rather than buffering.
	reverse_proxy behold:4600 {
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}
