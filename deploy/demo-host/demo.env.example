# The demo host's settings (#570). demo-host.sh bootstrap copies this file to
# /etc/demo-host/demo.env (mode 600) and sets any key a secrets file names.
# Nothing in it is secret: the password lives only as a bcrypt hash in
# /etc/demo-host/caddy/password.caddy, and the generated Forgejo and floci
# keys in /var/lib/demo-host.

# What the host runs. Until 2026-11-03 both are main, built from the
# checkouts. On 2026-11-03 they become the release tags, in one command:
#   sudo /opt/demo/behold/deploy/demo-host/demo-host.sh update --terragucci-ref v<x.y.z> --behold-ref behold-v<x.y.z>
TERRAGUCCI_REF=main
BEHOLD_REF=main

# The public name. Caddy gets its certificate; DNS points it at the Elastic IP.
DEMO_HOSTNAME=demo.intentius.io
# The basic-auth user until launch morning.
DEMO_AUTH_USER=preview

# What terragucci's stack/demo.sh makes (INTENTIUS/terragucci#1014): the
# repos on the stack's Forgejo, one per tool the loop runs, space-separated
# (behold#571; behold serves the first unless a page asks for another), and
# the reports bucket and prefix in floci, where demo.json is written.
DEMO_REPOS="terragucci-admin/demo terragucci-admin/demo-terragrunt terragucci-admin/demo-chant"
DEMO_REPORTS=s3://demo-reports/demo
# The scenarios the loop runs, space-separated (terragucci's stack/demo.sh:
# a-known, a-output, b-waves, failure, stale-plan, b-composed,
# tg-planned-outputs, chant-pr-loop). Empty or unset runs terragucci's default
# list, which leaves chant-pr-loop out: its jobs install OpenTofu and chant from
# the internet. An
# unknown name stops the driver, which logs it and restarts.
DEMO_SCENARIOS=
# The Forgejo user whose read-only token behold fetches chant/lifecycle with.
DEMO_VIEWER_USER=demo-viewer

# terragucci's stack, as its scripts default them.
TG_NETWORK=terragucci
TERRAGUCCI_FORGEJO_PORT=3300
TERRAGUCCI_FLOCI_PORT=4580

# The watchdog, in seconds. STALE must be longer than the driver's longest
# step limit (DEMO_LIMIT_RUN and DEMO_LIMIT_QUIET, 900 each by default).
DEMO_WATCHDOG_INTERVAL=15
DEMO_WATCHDOG_STALE=1800
DEMO_WATCHDOG_STALLED_GRACE=300
DEMO_WATCHDOG_BOOT=3600
