{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.INTENTIUS/behold",
  "title": "behold",
  "description": "Your infrastructure repo as a graph, from the files. Draws Terraform roots, no state needed.",
  "version": "0.33.1",
  "repository": {
    "url": "https://github.com/INTENTIUS/behold",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@intentius/behold",
      "version": "0.33.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
