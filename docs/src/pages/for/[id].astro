---
// One page per tile and per role, at /behold/for/<id>/, from data/rooms.mjs
// (the picker on the home page reads the same file). The page carries its
// Markdown in `markdown` for "Copy page as Markdown" and llms-full.txt, and
// its prompt in `prompt`, which the title shows as the agent-prompt card.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Room from '../../components/Room.astro';
import { ROOMS, checkRooms } from '../../data/rooms.mjs';
import { roomMarkdown } from '../../data/room-markdown.mjs';

export function getStaticPaths() {
	checkRooms();
	return ROOMS.map((r) => ({ params: { id: r.id } }));
}

const r = ROOMS.find((x) => x.id === Astro.params.id)!;
const site = new URL(import.meta.env.BASE_URL, Astro.site).href.replace(/\/$/, '');
---
<StarlightPage frontmatter={{ title: r.title, description: r.lede.replace(/`/g, ''), tableOfContents: false, prompt: r.prompt, markdown: roomMarkdown(r, site) }}>
	<Room id={r.id} />
</StarlightPage>
