---
// The header's right side: a Docs link first, so the docs are one click from
// the home page (whose splash layout has no sidebar), then the live demo, then
// Starlight's own social icons.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { docsHref } from '../site';
import { LIVE } from '../data/live.mjs';
---
<a class="bh-docs" href={docsHref}>Docs</a>
<a class="bh-docs bh-demo" href={LIVE}>Demo</a>
<Default />

<style>
	.bh-docs {
		margin-right: 0.5rem;
		padding: 0.3rem 0.8rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
		border: 1px solid var(--bh-rule);
		border-radius: 999px;
	}
	.bh-docs:hover {
		border-color: var(--bh-gold);
	}
	.bh-demo {
		border-color: var(--bh-gold);
	}
</style>
