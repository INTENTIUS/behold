---
// The site title: the pixel face beside the name, drawn as a mask over the
// text colour so it follows the theme (styles/custom.css). On a phone a Docs
// link sits beside it, since Starlight hides the header's right side (where
// SocialIcons.astro puts Docs and Demo) below its md width, so both sit here.
import { docsHref } from '../site';
import { LIVE } from '../data/live.mjs';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title sl-flex">
	<span class="bh-logo" aria-hidden="true"></span>
	<span translate="no">{siteTitle}</span>
</a>
<a class="bh-docs-phone" href={docsHref}>Docs</a>
<a class="bh-docs-phone bh-demo-phone" href={LIVE}>Demo</a>

<style>
	.site-title {
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.bh-docs-phone {
		align-self: center;
		margin-left: 0.75rem;
		padding: 0.2rem 0.65rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
		border: 1px solid var(--bh-rule);
		border-radius: 999px;
		white-space: nowrap;
	}
	.bh-demo-phone {
		margin-left: 0.4rem;
		border-color: var(--bh-gold);
	}
	@media (min-width: 50rem) {
		.bh-docs-phone {
			display: none;
		}
	}
</style>
