{
  "__inputs": [
    {
      "name": "DS_INFINITY",
      "label": "Infinity",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "yesoreyeram-infinity-datasource",
      "name": "Infinity",
      "version": "4.1.6"
    },
    {
      "type": "panel",
      "id": "nodeGraph",
      "name": "Node Graph",
      "version": ""
    }
  ],
  "title": "behold estate graph with status",
  "uid": "behold-graph-status",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Draws a behold graph.json in the node graph panel. As fresh as the last behold export.",
  "templating": {
    "list": [
      {
        "name": "graph_url",
        "label": "graph.json URL",
        "type": "textbox",
        "query": "https://OWNER.github.io/REPO/graph.json",
        "current": {
          "text": "https://OWNER.github.io/REPO/graph.json",
          "value": "https://OWNER.github.io/REPO/graph.json"
        }
      },
      {
        "name": "viewer_url",
        "label": "Viewer URL",
        "type": "textbox",
        "query": "https://OWNER.github.io/REPO/",
        "current": {
          "text": "https://OWNER.github.io/REPO/",
          "value": "https://OWNER.github.io/REPO/"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "nodeGraph",
      "title": "Estate graph",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 40
      },
      "options": {
        "layoutAlgorithm": "layered",
        "zoomMode": "cooperative"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "title"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in the behold viewer",
                    "url": "${viewer_url}?node=${__data.fields.id}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "nodes",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "format": "node-graph-nodes",
          "url": "${graph_url}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "nodes",
          "parser": "simple",
          "columns": [
            {
              "selector": "id",
              "text": "id",
              "type": "string"
            },
            {
              "selector": "title",
              "text": "title",
              "type": "string"
            },
            {
              "selector": "subtitle",
              "text": "subtitle",
              "type": "string"
            },
            {
              "selector": "mainstat",
              "text": "mainstat",
              "type": "string"
            },
            {
              "selector": "color",
              "text": "color",
              "type": "string"
            }
          ]
        },
        {
          "refId": "edges",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "format": "node-graph-edges",
          "url": "${graph_url}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "edges",
          "parser": "simple",
          "columns": [
            {
              "selector": "id",
              "text": "id",
              "type": "string"
            },
            {
              "selector": "source",
              "text": "source",
              "type": "string"
            },
            {
              "selector": "target",
              "text": "target",
              "type": "string"
            }
          ]
        }
      ]
    }
  ]
}
