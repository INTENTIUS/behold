{
  "name": "@intentius/backstage-plugin-behold",
  "version": "0.1.0",
  "description": "An Infrastructure tab on a Backstage component: the Terraform roots its annotation names, and their neighbours, drawn from a published behold graph.json",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.esm.js",
        "types": "./dist/index.d.ts"
      },
      "./alpha": {
        "import": "./dist/alpha.esm.js",
        "types": "./dist/alpha.d.ts"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "alpha": [
          "dist/alpha.d.ts"
        ]
      }
    }
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "behold",
    "pluginPackages": [
      "@intentius/backstage-plugin-behold"
    ]
  },
  "sideEffects": false,
  "keywords": [
    "backstage",
    "backstage-plugin",
    "terraform",
    "infrastructure",
    "graph"
  ],
  "scripts": {
    "sync": "node scripts/sync-behold.mjs",
    "start": "backstage-cli package start",
    "build": "tsc && backstage-cli package build",
    "tsc": "tsc --noEmit",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --watchAll=false",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.2",
    "@backstage/core-components": "^0.18.15",
    "@backstage/core-plugin-api": "^1.12.11",
    "@backstage/frontend-plugin-api": "^0.18.2",
    "@backstage/plugin-catalog-react": "^3.3.0",
    "@material-ui/core": "^4.12.2",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/cli-defaults": "^0.1.7",
    "@backstage/test-utils": "^1.7.23",
    "@jest/environment-jsdom-abstract": "^30.5.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^8.57.1",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.5.0",
    "jsdom": "^27.1.0",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2",
    "typescript": "~5.8.0"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "homepage": "https://github.com/INTENTIUS/behold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTENTIUS/behold.git",
    "directory": "surfaces/backstage-plugin-behold"
  }
}
