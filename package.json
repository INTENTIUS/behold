{
  "name": "@intentius/behold",
  "version": "0.34.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Your infrastructure repo as a graph, from the files. Draws Terraform roots, no state needed.",
  "bin": {
    "behold": "./bin/behold.js"
  },
  "mcpName": "io.github.INTENTIUS/behold",
  "files": [
    "bin",
    "dist",
    "schemas",
    "web",
    "example-writes",
    "example-k8s",
    "example-flux-estate",
    "example-argo-estate",
    "example-carve",
    "example-terraform-estate",
    "example-choudoufu-estate",
    "example-terralith",
    "example-three-cloud",
    "!example-three-cloud/**/node_modules",
    "demos.json",
    "AGENTS.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "licenses"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "demo": "npm --prefix example-writes install && tsx src/cli.ts serve example-writes --local --env prod",
    "demo:k8s": "bash example-k8s/scripts/local/local-up.sh; npm --prefix example-k8s install && tsx src/cli.ts serve example-k8s --local --env local; bash example-k8s/scripts/local/local-down.sh",
    "smoke:ui": "tsx smoke/ui-smoke.mjs",
    "preview:dots": "tsx scripts/dots-preview.ts",
    "export:carve": "tsx scripts/export-carve.ts",
    "preview:carve": "tsx scripts/export-carve.ts && node scripts/serve-static.mjs dist-carve 4712",
    "preview:tour": "tsx scripts/tour-preview.ts",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "generate:graph-layout": "tsx src/graph-db/generate-layout.ts",
    "check:graph-layout": "tsx src/graph-db/generate-layout.ts --check",
    "generate:icons": "tsx src/generate-icons.ts",
    "check:icons": "tsx src/generate-icons.ts --check",
    "check:browser-bundle": "tsx scripts/check-browser-bundle.mts",
    "build": "tsx src/graph-db/generate-layout.ts && tsx src/generate-icons.ts && esbuild cli=src/cli.ts index=src/graph-package.ts --bundle --platform=node --format=esm --external:hono --external:@hono/node-server --external:@intentius/pinhole --external:@kubernetes/client-node --external:ajv --external:@modelcontextprotocol/sdk --external:@ladybugdb/core --splitting --outdir=dist && esbuild src/graph-db/browser.ts --bundle --platform=browser --format=esm --legal-comments=none --log-level=warning --outfile=dist/graph-db-wasm.js && chmod +x dist/cli.js",
    "build:viewer": "tsx scripts/build-viewer.mts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cdktn/hcl2json": "^0.24.0",
    "@hono/node-server": "^2.0.5",
    "@intentius/chant": "^0.124.107",
    "@intentius/chant-lexicon-k8s": "0.124.104",
    "@intentius/chant-lexicon-otel": "0.124.102",
    "@intentius/chant-lexicon-prometheus": "0.124.101",
    "@intentius/chant-lexicon-pulumi": "^0.124.102",
    "@intentius/chant-lexicon-sql": "^0.124.102",
    "@intentius/chant-lexicon-terraform": "^0.124.102",
    "@intentius/pinhole": "^0.6.0",
    "@ladybugdb/wasm-core": "0.22.3",
    "@modelcontextprotocol/sdk": "1.30.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.0",
    "hono": "^4.13.13",
    "tsx": "^4.19.0"
  },
  "peerDependencies": {
    "@intentius/chant-k8s-client": "^0.124.100",
    "@intentius/chant-lexicon-aws": "^0.124.103",
    "@ladybugdb/core": ">=0.22.1",
    "playwright-core": "^1.62.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "@ladybugdb/core": {
      "optional": true
    },
    "@intentius/chant-k8s-client": {
      "optional": true
    },
    "@intentius/chant-lexicon-aws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@intentius/chant-k8s-client": "^0.124.101",
    "@intentius/chant-lexicon-aws": "^0.124.104",
    "@ladybugdb/core": "0.22.3",
    "@types/node": "^26.4.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTENTIUS/behold.git"
  },
  "bugs": {
    "url": "https://github.com/INTENTIUS/behold/issues"
  },
  "homepage": "https://github.com/INTENTIUS/behold#readme"
}
