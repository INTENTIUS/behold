{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behold.tour/v1",
  "title": "A behold tour: chapters over a cycle's real events",
  "type": "object",
  "required": ["schema", "name", "chapters"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "behold.tour/v1" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "title": { "type": "string", "maxLength": 120 },
    "match": {
      "description": "Which demo cycles this tour narrates: demo.json's tool or scenario.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": { "tool": { "type": "string" }, "scenario": { "type": "string" } }
    },
    "home": {
      "description": "The repo {repo} names, under demo.json's repo's owner; without it, demo.json's repo.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}$"
    },
    "steps": {
      "description": "demo.json steps in the order a beat walks them, for how far a chapter has got.",
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 20
    },
    "replay": {
      "description": "How a recorded cycle of this tour plays condensed (web/cycle-replay.js), each in ms: an idle stretch longer than maxGapMs plays as keepMs and is marked on the timeline with the real gap; each chapter stays up at least chapterMinMs; a write's flight plays whole for flightMs; the last chapter holds endHoldMs before the replay starts again.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxGapMs": { "type": "integer", "minimum": 500, "maximum": 600000 },
        "keepMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "chapterMinMs": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "endHoldMs": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "flightMs": { "type": "integer", "minimum": 0, "maximum": 30000 }
      }
    },
    "runs": {
      "description": "Named runs of the cycle, each found in the reports' index or by a migration record's commit.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$" },
      "additionalProperties": { "$ref": "#/$defs/run" }
    },
    "facts": {
      "description": "Named numbers and values, each taken from a record. A fact with no record behind it is left out.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$" },
      "additionalProperties": { "$ref": "#/$defs/fact" }
    },
    "chapters": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/chapter" } }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,31}$" },
    "run": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["migration"],
          "properties": { "migration": { "type": "string", "pattern": "^[A-Za-z0-9._~@+-]{1,128}$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "stage"],
          "properties": {
            "repo": { "type": "string", "description": "The forge repo; {repo} is demo.json's repo." },
            "stage": { "enum": ["tf-plan", "tf-apply"] },
            "wave": { "type": "integer", "minimum": 1 },
            "pull": { "type": "null", "description": "null: a run with no pull request (a push)." },
            "after": { "$ref": "#/$defs/name", "description": "Only runs that finished after this named run." },
            "pick": { "enum": ["first", "last"] }
          }
        }
      ]
    },
    "fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run", "value"],
          "properties": {
            "run": { "$ref": "#/$defs/name" },
            "value": { "enum": ["planned", "changed", "recreated", "output", "job"] },
            "output": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["migration", "value"],
          "properties": {
            "migration": { "type": "string" },
            "value": { "enum": ["stamped", "moved", "refused", "skipped", "writes", "version_id", "approved_by", "moved_resources", "stamped_resources", "refused_resources"] }
          }
        },
        {
          "description": "The distinct resources a tag write landed on across these migrations' progress lines.",
          "type": "object",
          "additionalProperties": false,
          "required": ["tagged"],
          "properties": { "tagged": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
        },
        { "type": "object", "additionalProperties": false, "required": ["sum"], "properties": { "sum": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/name" } } } },
        { "type": "object", "additionalProperties": false, "required": ["approvals"], "properties": { "approvals": { "const": true } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration"],
          "properties": {
            "duration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": { "from": { "const": "started_at" }, "to": { "$ref": "#/$defs/name" } }
            }
          }
        }
      ]
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": { "beat": { "type": "string" }, "step": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["migration", "line"],
          "properties": { "migration": { "type": "string" }, "line": { "enum": ["first", "last"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["wave", "edge"],
          "properties": { "wave": { "type": "integer", "minimum": 1 }, "edge": { "enum": ["start", "end"] }, "after": { "$ref": "#/$defs/name" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trigger" } } }
        }
      ]
    },
    "show": {
      "description": "One visual, each standing on a record: a run's plan, a migration record, the read threads of a plan.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "light": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/name" }, "description": "Light what the first of these runs planned (the first that planned anything)." },
        "pulse": { "$ref": "#/$defs/name", "description": "Pulse the boxes of the roots this run planned." },
        "travel": { "$ref": "#/$defs/name", "description": "This plan's output value, along its read threads to its readers." },
        "output": { "type": "string" },
        "wave": { "type": "integer", "minimum": 1 },
        "state": { "type": "string", "description": "A migration's source state file, by its version id." },
        "checks": { "$ref": "#/$defs/name", "description": "Each root of this run that plans no change." },
        "counts": { "const": "estates" },
        "card": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "object", "additionalProperties": false, "required": ["label", "text"], "properties": { "label": { "type": "string" }, "text": { "type": "string" } } }
        },
        "when": { "$ref": "#/$defs/trigger" }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "trigger": { "$ref": "#/$defs/trigger" },
        "title": { "type": "string", "maxLength": 80 },
        "text": { "type": "array", "maxItems": 2, "items": { "type": "string", "maxLength": 120 } },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "boxes": { "enum": ["source", "all", "lit"] } }
        },
        "show": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/show" } }
      }
    }
  }
}
