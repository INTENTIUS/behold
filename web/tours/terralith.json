{
  "schema": "behold.tour/v1",
  "name": "terralith",
  "title": "Carving a shared root into team estates",
  "match": {
    "tool": "terralith"
  },
  "home": "demo-terralith",
  "steps": [
    "pull-request",
    "planned",
    "merged",
    "applying",
    "waiting",
    "approved",
    "resumed",
    "applied"
  ],
  "replay": {
    "maxGapMs": 3000,
    "keepMs": 800,
    "chapterMinMs": 6000,
    "endHoldMs": 8000,
    "flightMs": 1800
  },
  "runs": {
    "stock": {
      "repo": "{repo}",
      "stage": "tf-apply",
      "pull": null,
      "pick": "first"
    },
    "adopt": {
      "migration": "adopt"
    },
    "split": {
      "migration": "split"
    },
    "team": {
      "repo": "{repo}-team-b",
      "stage": "tf-plan",
      "pick": "first"
    },
    "teamApply": {
      "repo": "{repo}-team-b",
      "stage": "tf-apply",
      "pick": "first"
    },
    "crossPlan": {
      "repo": "{repo}",
      "stage": "tf-plan",
      "after": "teamApply",
      "pick": "last"
    },
    "cross1": {
      "repo": "{repo}",
      "stage": "tf-apply",
      "wave": 1,
      "after": "crossPlan",
      "pick": "last"
    },
    "cross2": {
      "repo": "{repo}",
      "stage": "tf-apply",
      "wave": 2,
      "after": "crossPlan",
      "pick": "last"
    }
  },
  "facts": {
    "planned": {
      "run": "stock",
      "value": "planned"
    },
    "of": {
      "run": "stock",
      "value": "planned"
    },
    "stamped": {
      "migration": "adopt",
      "value": "stamped_resources"
    },
    "moved": {
      "migration": "split",
      "value": "moved_resources"
    },
    "refused": {
      "migration": "split",
      "value": "refused_resources"
    },
    "teamPlanned": {
      "run": "team",
      "value": "planned"
    },
    "teamChanged": {
      "run": "team",
      "value": "changed"
    },
    "value": {
      "run": "crossPlan",
      "value": "output",
      "output": "log_retention_days"
    },
    "adoptRecreated": {
      "run": "adopt",
      "value": "recreated"
    },
    "splitRecreated": {
      "run": "split",
      "value": "recreated"
    },
    "recreated": {
      "sum": [
        "adoptRecreated",
        "splitRecreated"
      ]
    },
    "approvals": {
      "approvals": true
    },
    "cycleTime": {
      "duration": {
        "from": "started_at",
        "to": "cross2"
      }
    },
    "tagged": {
      "tagged": [
        "adopt",
        "split"
      ]
    }
  },
  "chapters": [
    {
      "id": "stock",
      "trigger": {
        "beat": "stock"
      },
      "title": "One shared root holds everything",
      "text": [
        "Every resource lives in one state file.",
        "Any change plans {planned} of {of} and waits on one lock."
      ],
      "focus": {
        "boxes": "source"
      },
      "show": [
        {
          "light": [
            "stock"
          ]
        }
      ]
    },
    {
      "id": "adopt",
      "trigger": {
        "beat": "adopt"
      },
      "title": "Adopt: claim every resource without touching it",
      "text": [
        "Each resource gets its owner's tags. Nothing is rebuilt.",
        "{stamped} resources tagged, and the state file stays as it was."
      ],
      "focus": {
        "boxes": "source"
      },
      "show": [
        {
          "state": "adopt"
        }
      ]
    },
    {
      "id": "split",
      "trigger": {
        "beat": "split"
      },
      "title": "Team B moves out, and nothing is recreated",
      "text": [
        "Team B's resources move to an estate of their own by a tag write. The other teams stay in the shared root for now.",
        "{moved} resources moved, {refused} refused."
      ],
      "focus": {
        "boxes": "all"
      },
      "show": [
        {
          "counts": "estates"
        },
        {
          "checks": "split",
          "when": {
            "migration": "split",
            "line": "last"
          }
        }
      ]
    },
    {
      "id": "team",
      "trigger": {
        "beat": "team"
      },
      "title": "A small change stays small",
      "text": [
        "Team B changes one policy, and only team B is planned.",
        "Planned {teamPlanned} of {of} · chapter 1: {planned} of {of}"
      ],
      "focus": {
        "boxes": "lit"
      },
      "show": [
        {
          "light": [
            "team"
          ]
        }
      ]
    },
    {
      "id": "cross",
      "trigger": {
        "beat": "cross"
      },
      "title": "A change across estates",
      "text": [
        "The shared root publishes a value, and team B reads it.",
        "Wave 1 plans the shared root; wave 2 plans team B with log_retention_days = {value}."
      ],
      "focus": {
        "boxes": "all"
      },
      "show": [
        {
          "pulse": "crossPlan",
          "wave": 1,
          "when": {
            "wave": 1,
            "edge": "start",
            "after": "crossPlan"
          }
        },
        {
          "travel": "crossPlan",
          "output": "log_retention_days",
          "when": {
            "wave": 1,
            "edge": "end",
            "after": "crossPlan"
          }
        },
        {
          "light": [
            "cross2",
            "crossPlan"
          ],
          "wave": 2,
          "when": {
            "wave": 2,
            "edge": "start",
            "after": "crossPlan"
          }
        }
      ]
    },
    {
      "id": "epilogue",
      "trigger": {
        "any": [
          {
            "beat": "cross",
            "step": "applied"
          },
          {
            "step": "reset"
          }
        ]
      },
      "title": "This cycle, in numbers",
      "text": [
        "After the reset, the next cycle starts again from a new shared root."
      ],
      "focus": {
        "boxes": "all"
      },
      "show": [
        {
          "travel": "crossPlan",
          "output": "log_retention_days",
          "when": {
            "wave": 1,
            "edge": "end",
            "after": "crossPlan"
          }
        },
        {
          "light": [
            "cross2",
            "crossPlan"
          ],
          "wave": 2,
          "when": {
            "wave": 2,
            "edge": "start",
            "after": "crossPlan"
          }
        },
        {
          "card": [
            {
              "label": "cycle time",
              "text": "{cycleTime}"
            },
            {
              "label": "resources tagged",
              "text": "{tagged}"
            },
            {
              "label": "resources recreated",
              "text": "{recreated}"
            },
            {
              "label": "approvals",
              "text": "{approvals}"
            },
            {
              "label": "planned per change",
              "text": "{planned} before, {teamPlanned} after"
            }
          ]
        }
      ]
    }
  ]
}
