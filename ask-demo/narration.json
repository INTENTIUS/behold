    {
      "id": "aws-ssh-open",
      "kind": "question",
      "prompt": "Is SSH open to the internet anywhere in our AWS account?",
      "reading": "I'll look for ingress rules that open port 22 to anywhere.",
      "call": {
        "tool": "ask",
        "arguments": {
          "cypher": "MATCH (r:Resource {source: 'index', kind: 'AWS::EC2::SecurityGroupIngress'}) WITH r, regexp_extract(r.attrs, '\"IpProtocol\":\"([^\"]+)\"', 1) AS protocol, regexp_extract(r.attrs, '\"FromPort\":(-?[0-9]+)', 1) AS fromPort, regexp_extract(r.attrs, '\"ToPort\":(-?[0-9]+)', 1) AS toPort, regexp_extract(r.attrs, '\"CidrIp\":\"([^\"]+)\"', 1) AS cidr, regexp_extract(r.attrs, '\"CidrIpv6\":\"([^\"]+)\"', 1) AS cidr6 WHERE cidr = '0.0.0.0/0' OR cidr6 = '::/0' WITH r, cidr + cidr6 AS source, CASE WHEN protocol = '-1' THEN 'all traffic' WHEN fromPort = toPort THEN protocol + ' ' + fromPort ELSE protocol + ' ' + fromPort + '-' + toPort END AS opens, (protocol = '-1' OR ((protocol = 'tcp' OR protocol = '6') AND CAST(CASE WHEN fromPort = '' THEN '-9' ELSE fromPort END AS INT64) <= 22 AND CAST(CASE WHEN toPort = '' THEN '-9' ELSE toPort END AS INT64) >= 22)) AS ssh RETURN r.key AS key, r.nativeId AS rule, opens, source, r.location AS region, CASE WHEN ssh THEN r.nativeId ELSE '' END AS sshRule, CASE WHEN ssh THEN '' ELSE r.nativeId + ' (' + opens + ')' END AS other ORDER BY sshRule DESC, rule"
        }
      },
      "busy": "behold mcp ask: running a Cypher query over the estate graph",
      "cypher": "MATCH (r:Resource {source: 'index', kind: 'AWS::EC2::SecurityGroupIngress'}) WITH r, regexp_extract(r.attrs, '\"IpProtocol\":\"([^\"]+)\"', 1) AS protocol, regexp_extract(r.attrs, '\"FromPort\":(-?[0-9]+)', 1) AS fromPort, regexp_extract(r.attrs, '\"ToPort\":(-?[0-9]+)', 1) AS toPort, regexp_extract(r.attrs, '\"CidrIp\":\"([^\"]+)\"', 1) AS cidr, regexp_extract(r.attrs, '\"CidrIpv6\":\"([^\"]+)\"', 1) AS cidr6 WHERE cidr = '0.0.0.0/0' OR cidr6 = '::/0' WITH r, cidr + cidr6 AS source, CASE WHEN protocol = '-1' THEN 'all traffic' WHEN fromPort = toPort THEN protocol + ' ' + fromPort ELSE protocol + ' ' + fromPort + '-' + toPort END AS opens, (protocol = '-1' OR ((protocol = 'tcp' OR protocol = '6') AND CAST(CASE WHEN fromPort = '' THEN '-9' ELSE fromPort END AS INT64) <= 22 AND CAST(CASE WHEN toPort = '' THEN '-9' ELSE toPort END AS INT64) >= 22)) AS ssh RETURN r.key AS key, r.nativeId AS rule, opens, source, r.location AS region, CASE WHEN ssh THEN r.nativeId ELSE '' END AS sshRule, CASE WHEN ssh THEN '' ELSE r.nativeId + ' (' + opens + ')' END AS other ORDER BY sshRule DESC, rule",
